<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.buffer-refill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>BUFFER_API_KEY="$(cat "$HOME/.config/buffer-queue/api-key")" exec /usr/bin/python3 -I /ABSOLUTE/PATH/TO/buffer-queue/refill.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/buffer-queue/refill.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/buffer-queue/refill.log</string>
</dict>
</plist>
